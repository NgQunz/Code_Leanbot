    speed = 1500;
    distance = 620;
    followLine();
    LbMotion.stopAndWait();

    re_phai(85);
    speed = 1500;
    distance = 300;
    followLine();
    LbMotion.stopAndWait();

    // Tha khoi vao khu E
    re_phai(42);
    di_thang(13);
    LbGripper.moveTo(0);

    // Quay ve CRL
    di_lui(13);
    re_trai(130);

    speed = 1500;
    distance = 300;
    followLine();
    LbMotion.stopAndWait();

    re_phai(85);
    speed = 1500;
    distance = 300;
    followLine();
    LbMotion.stopAndWait();

    re_phai(85);
    di_thang(12);
    LbMotion.stopAndWait();
  }

  else
  {
    // RED / YELLOW / MYSTERY
    // Gap khoi E2
    LbGripper.moveTo(90);
    di_lui(8);

    // Huong ra duong line phia duoi
    re_phai(42);

    // Di theo line den CRL
    speed = 1500;
    distance = 300;
    followLine();
    LbMotion.stopAndWait();

    // Tiep can CRL - doan thu nghiem
    re_phai(42);
    di_thang(12);

    // Tha khoi trong CRL
    LbGripper.moveTo(0);

    // Can chinh lai vi tri dung cuoi cung
    LbMotion.stopAndWait();
  }
}

